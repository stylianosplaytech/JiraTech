{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "introspectComments": true,
          "controllerKeyOfComment": "summary",
          "controllerFileNameSuffix": [".controller.ts"],
          "dtoFileNameSuffix": [".dto.ts", "dto.ts", ".entity.ts"]
        }
      }
    ]
  },
  "watchOptions": {
    "watchAssets": false,
    "ignored": ["**/prisma/dev.db", "**/prisma/dev.db-journal", "**/dist/**"]
  }
}
