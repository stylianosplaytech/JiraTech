{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false
  },
  "watchOptions": {
    "watchAssets": false,
    "ignored": ["**/prisma/dev.db", "**/prisma/dev.db-journal", "**/dist/**"]
  }
}
