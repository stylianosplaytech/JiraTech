# SQLite (default, no Docker needed):
DATABASE_URL="file:./dev.db"
# PostgreSQL (start it with `npm run db:up`, then `npm run db:push -w backend`):
# DATABASE_URL="postgresql://jiratech:jiratech@localhost:5432/jiratech"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN="7d"
PORT=3000
# Service desk mailboxes (IMAP): MAIL_SECRET encrypts their stored passwords (defaults to JWT_SECRET)
# MAIL_SECRET=change-me-too
# MAIL_POLL_SECONDS=60
# MAIL_POLLING=false
