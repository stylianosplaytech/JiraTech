# SQLite (default, no Docker needed):
DATABASE_URL="file:./dev.db"
# PostgreSQL (start it with `npm run db:up`, then `npm run db:push -w backend`):
# DATABASE_URL="postgresql://conductor:conductor@localhost:5432/conductor"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN="7d"
PORT=3000
# Mail passwords saved in the app (Email settings, service desk mailboxes) are encrypted with MAIL_SECRET (defaults to JWT_SECRET)
# MAIL_SECRET=change-me-too
# MAIL_POLL_SECONDS=60
# MAIL_POLLING=false
# Webhooks may call servers on private networks (default: refused). WEBHOOK_WORKER=false stops this process retrying failed deliveries.
# WEBHOOK_ALLOW_PRIVATE=true
# WEBHOOK_WORKER=false
# AUTOMATION_SCHEDULER=false stops this process running scheduled automation rules.
# API_DOCS=false switches off the API reference at /api/docs and /api/openapi.json.
# A service desk mailbox set here instead of in the app (survives a database reset), named after the project key, e.g. HELP:
# EMAIL_HELP_ADDRESS=help@example.com
# EMAIL_HELP_IMAP_HOST=imap.gmail.com
# EMAIL_HELP_IMAP_PASSWORD=app-password
# Optional: EMAIL_HELP_IMAP_USER (default: the address), _IMAP_PORT (993), _IMAP_SECURE (true), _IMAP_FOLDER (INBOX),
#           _PORTAL (link name), _REQUEST_TYPE (name), _ACCEPT_ANYONE (true), _ENABLED (true)
# Outgoing email through a Gmail account (Google API, HTTPS) when nothing is set under Email settings in the app:
# GMAIL_CLIENT_ID=1234-abc.apps.googleusercontent.com
# GMAIL_CLIENT_SECRET=...
# GMAIL_REFRESH_TOKEN=...
# GMAIL_USER=conductor@gmail.com
